# Copy to .env (never commit this file)
# --- required for full features ---
EIA_API_KEY=              # free key: https://www.eia.gov/opendata/  (stockpiles, propane, jet)
DART_API_KEY=             # free key: https://opendart.fss.or.kr  (Korea statements + share counts)
JQUANTS_API_KEY=          # free key: https://jpx-jquants.com        (Japan statements + JPX ratios)

# --- optional ---
# SEC_UA=MarlonWatchtower/1.0 (you@example.com)   # SEC asks for a contact address in the User-Agent
# PORT=4173
# FRED_API_KEY=           # free key: https://fredaccount.stlouisfed.org/apikeys  (release calendar)
# AUTH_USER=you        # set BOTH to protect a public deployment with a login prompt
# AUTH_PASS=secret
# DIGEST_HOUR=7           # hour (0-23) to send the daily brief
# ALERT_COOLDOWN_H=12
# WEBHOOK_URL=            # Slack/Discord/generic webhook for alerts + brief
# RESEND_API_KEY=         # one key, no domain: sends from onboarding@resend.dev to your own address
# SMTP_USER=              # email the brief (Gmail app password required)
# SMTP_PASS=
# DIGEST_TO=
# NOTIFY=off              # desktop notifications only work on macOS (off on servers)
# UPSTASH_REDIS_REST_URL= # keeps subscribers/rules/cooldowns across redeploys (free Upstash, REST)
# UPSTASH_REDIS_REST_TOKEN=
# STATE_KEY=watchtower:state
