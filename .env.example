# Copy to .env (never commit this file)
# --- required for full features ---
AISSTREAM_KEY=            # free key: https://aisstream.io  (live ships)
EIA_API_KEY=              # free key: https://www.eia.gov/opendata/  (stockpiles, propane, jet)

# --- optional ---
# PORT=4173
# AUTH_USER=you        # set BOTH to protect a public deployment with a login prompt
# AUTH_PASS=secret
# DIGEST_HOUR=7           # hour (0-23) to send the daily brief
# ALERT_COOLDOWN_H=12
# WEBHOOK_URL=            # Slack/Discord/generic webhook for alerts + brief
# SMTP_USER=              # email the brief (Gmail app password required)
# SMTP_PASS=
# DIGEST_TO=
# NOTIFY=off              # desktop notifications only work on macOS (off on servers)
