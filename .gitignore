node_modules/
.env
.state.json
.regime-cache.json
.reroute.json
.flares.json
.DS_Store
*.log

# Built in the deploy image (see Dockerfile): minified copies of the client, served at /app.js and
# /style.css. Committing them would let a stale build shadow a newer source file.
public/app.min.js
public/style.min.css

# Wrangler's local build cache
**/.wrangler/

# transient editor/agent backups
.tmp-*.js

# SEC filing cache used by scripts/fetch-ma.mjs
data/.ma-cache/

data/.sic-cache.json
data/.gdelt-progress.json
data/.doc-heads/

# Concept-level XBRL responses cached by scripts/fill-gaps.mjs (rebuilt on demand)
data/cache/
# Raw universe holdings downloads used by the US universe/tier scripts
data/.sptm-holdings.xlsx
data/.spy-holdings.xlsx
data/.mdy-holdings.xlsx
data/.spsm-holdings.xlsx
